{
  "name": "simpanjual-monorepo",
  "version": "2.1.0",
  "private": true,
  "description": "SimpanJual Cross-Platform Modular Monolith (Flutter Mobile + React.js Web + Go Backend + Podman PostgreSQL)",
  "scripts": {
    "db:up": "node scripts/db-container.mjs up",
    "db:down": "node scripts/db-container.mjs down",
    "db:status": "node scripts/db-container.mjs status",
    "backend:migrate": "cd backend && go run ./cmd/dbtool up",
    "backend:seed": "cd backend && go run ./cmd/dbtool seed",
    "backend:reset": "cd backend && go run ./cmd/dbtool reset",
    "backend:dev": "cd backend && go run ./cmd/api",
    "backend:start": "cd backend && go build -o bin/simpanjual-api.exe ./cmd/api && ./bin/simpanjual-api.exe",
    "backend:test": "cd backend && go test -v ./...",
    "mobile:test": "cd mobile && flutter analyze && flutter test",
    "mobile:web": "cd mobile && flutter run -d chrome",
    "mobile:apk": "cd mobile && flutter build apk --release",
    "web:dev": "cd web && npm run dev",
    "web:build": "cd web && npm run build"
  }
}
