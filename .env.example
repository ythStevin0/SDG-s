# Database (Lokal: Podman port 5435 | Produksi: Neon / Cloud Postgres)
DATABASE_URL="postgresql://simpanjual:simpanjual_dev@127.0.0.1:5435/simpanjual"

# Session JWT (isi string acak minimal 32 karakter di produksi)
JWT_SECRET="ganti-dengan-secret-acak-minimal-32-karakter"

# AI Opsional (F14 & F15) - aplikasi tetap berjalan 100% jika AI_ENABLED="false"
AI_ENABLED="false"
GOOGLE_GENERATIVE_AI_API_KEY=""
LLM_MODEL="gemini-2.5-flash"
AI_RATE_LIMIT_PER_HOUR="10"
