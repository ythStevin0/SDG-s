# =====================================================================
# SimpanJual — Cross-Platform Modular Monolith Configuration
# =====================================================================

# 1. Database PostgreSQL 17 (Lokal: Podman port 5435 | Produksi: Neon / Cloud Postgres)
DATABASE_URL="postgresql://simpanjual:simpanjual_dev@127.0.0.1:5435/simpanjual"
DB_MAX_CONNS="20"
DB_MIN_CONNS="2"
DB_CONNECT_TIMEOUT_MS="5000"

# 2. Go Modular Monolith HTTP Server & Keamanan
PORT="8080"
JWT_SECRET="ganti-dengan-secret-acak-minimal-32-karakter"
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,*"
RATE_LIMIT_PER_MINUTE="180"
MAX_BODY_BYTES="1048576"
REQUEST_TIMEOUT_MS="15000"

# 3. AI Terkendali Opsional (F14 & F15) - sistem 100% fungsional jika AI_ENABLED="false"
AI_ENABLED="false"
GOOGLE_GENERATIVE_AI_API_KEY=""
LLM_MODEL="gemini-2.5-flash"
AI_RATE_LIMIT_PER_HOUR="10"
AI_TIMEOUT_MS="8000"

# 4. React.js Web Companion (Vite)
VITE_API_BASE_URL="http://localhost:8080"
